char = { ASCII_ALPHANUMERIC | "." | "_" | "/" }
name = @{ char+ }
value_char = { char | "(" | ")" }
value_text = @{ value_char* }
variable = { "(" ~ name ~ "." ~ name ~ ")" }
value = { variable | value_text }
section = { "|=>" ~ name ~ "<=|" }
property = { name ~ "=>" ~ value }
file = { SOI ~ ((section | property)? ~ NEWLINE)* ~ EOI }
WHITESPACE = _{ " " }